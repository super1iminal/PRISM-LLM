{
 "approach": "legacy",
 "domain": {
  "name": "gridworld",
  "dataset": "grid_20_balanced.csv",
  "visible_extra": [
   "obs_idx"
  ]
 },
 "llm": {
  "model": "qwen3:14b-q4_K_M",
  "think": false,
  "num_ctx": 16384,
  "num_predict": 8192,
  "seed": 1,
  "temperature": null,
  "backend": "ollama",
  "openrouter": {
   "base_url": "https://openrouter.ai/api/v1",
   "api_key_env": "OPENROUTER_API_KEY",
   "providers": [],
   "quantizations": [],
   "timeout_s": 600,
   "max_retries": 2
  }
 },
 "planner": {
  "max_rounds": 5,
  "max_fixups": 2,
  "retry": "gain:0.05",
  "branch": "joint",
  "feedback": "blame",
  "max_rules": 64,
  "max_condition_chars": 200
 },
 "feedback": {
  "blame": "mass",
  "horizon": 100,
  "top_k": 10,
  "states_per_rule": 3
 },
 "prompt": {
  "catch_all_instruction": true,
  "examples": true
 },
 "prism": {
  "method": "gaussseidel",
  "fallback_methods": [
   "modpoliter"
  ],
  "java_max_mem": "4g",
  "max_iters": 1000000,
  "timeout_s": 900,
  "multi_engine": "sparse",
  "multi_method": "lp",
  "exact_check": true,
  "exact_epsilon": "1e-9",
  "exact_fallback_epsilon": "1e-12",
  "exact_max_iters": 100000000
 },
 "rules": {
  "max_enumeration": 200000
 },
 "legacy": {
  "max_rounds": 5,
  "retry": "never",
  "examples": true
 },
 "run": {
  "workers": 2,
  "limit": null,
  "scheduler": "threads"
 },
 "condition": "B1"
}