{
 "approach": "symbolic",
 "domain": {
  "name": "pacman",
  "dataset": "pacman_transfer.csv",
  "visible_extra": [
   "obs_idx"
  ]
 },
 "llm": {
  "model": "anthropic/claude-haiku-5.5",
  "think": true,
  "num_ctx": 16384,
  "num_predict": 16384,
  "seed": null,
  "temperature": null,
  "backend": "openrouter",
  "openrouter": {
   "base_url": "https://openrouter.ai/api/v1",
   "api_key_env": "OPENROUTER_API_KEY",
   "providers": [
    "anthropic"
   ],
   "quantizations": [],
   "timeout_s": 600,
   "max_retries": 2
  }
 },
 "planner": {
  "max_rounds": 8,
  "max_fixups": 2,
  "retry": "never",
  "branch": "joint",
  "feedback": "blame",
  "max_rules": 64,
  "max_condition_chars": 200
 },
 "feedback": {
  "blame": "mass",
  "horizon": "domain",
  "top_k": 10,
  "states_per_rule": 3,
  "space": "states",
  "trajectory": false,
  "early": "steps",
  "early_tolerance": 0.01,
  "early_refine": true,
  "early_group": [
   "xP",
   "yP"
  ]
 },
 "prompt": {
  "catch_all_instruction": true,
  "examples": true,
  "generality": true,
  "strategy_first": false,
  "tie_break": false,
  "hint": ""
 },
 "prism": {
  "method": "gaussseidel",
  "fallback_methods": [
   "modpoliter"
  ],
  "java_max_mem": "4g",
  "max_iters": 1000000,
  "timeout_s": 900,
  "multi_engine": "sparse",
  "multi_method": "lp",
  "exact_check": true,
  "exact_epsilon": "1e-9",
  "exact_fallback_epsilon": "1e-12",
  "exact_max_iters": 100000000,
  "max_concurrent": 8
 },
 "rules": {
  "max_enumeration": 200000,
  "extended": true,
  "general": true,
  "shared_literals": true,
  "hidden_features": [
   "closer_g0",
   "closer_g1"
  ],
  "any_order": "rotations",
  "any_scorer": "prism",
  "any_prune": false
 },
 "legacy": {
  "max_rounds": 5,
  "retry": "never",
  "examples": true
 },
 "run": {
  "workers": 1,
  "limit": null,
  "scheduler": "event",
  "train_sets": [
   [
    3,
    4,
    5
   ]
  ],
  "hidden_sets": [],
  "pool_sets": []
 },
 "condition": "haiku_pac_early_refine"
}