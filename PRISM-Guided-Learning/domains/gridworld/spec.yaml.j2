actions:
  up: "move to (x-1, y), i.e. one row up"
  right: "move to (x, y+1), i.e. one column right"
  down: "move to (x+1, y), i.e. one row down"
  left: "move to (x, y-1), i.e. one column left"

# Policy-visible variables (types/ranges come from the model). The moving obstacle's phase
# (obs_idx) is listed under optional_variables: visible only when the config's
# domain.visible_extra includes it (the default since Phase A; hidden in the pre-Phase-A runs).
optional_variables:
  - name: obs_idx
    description: "moving obstacle's position in its patrol cycle: {% for r, c in cycle %}{{ loop.index0 }} = ({{ r }},{{ c }}){% if not loop.last %}, {% endif %}{% endfor %}"
variables:
  - name: x
    description: "agent row (0 = top)"
  - name: y
    description: "agent column (0 = left)"
{% for g in goals %}
  - name: g{{ g.k }}
    description: "true once goal {{ g.k }} has been reached{% if not loop.first %} (only counts after goal {{ loop.previtem.k }}){% endif %}"
{% endfor %}

requirements:
{% for r in requirements %}
  - name: {{ r.name }}
    formula: '{{ r.formula }}'
    bound: ">="
    threshold: {{ r.threshold }}
    description: "{{ r.description }}"
{% endfor %}
