actions:
  right: "at a crossing, go right (x + 1); if there is a wall, stay"
  up: "at a crossing, go up (y + 1); if there is a wall, stay"
  left: "at a crossing, go left (x - 1); if there is a wall, stay"
  down: "at a crossing, go down (y - 1); if there is a wall, stay"

# Policy-visible variables: the whole game state Pac-Man decides on (the turn token pMove is always 2
# when Pac-Man moves). A deactivated ghost sits at (0, 0).
variables:
  - name: xP
    description: "Pac-Man's column (1 = left, 10 = right)"
  - name: yP
    description: "Pac-Man's row (1 = bottom, 6 = top)"
  - name: dP
    description: "Pac-Man's heading: {% for code, name in directions.items() %}{{ code }} = {{ name }}{% if not loop.last %}, {% endif %}{% endfor %}"
  - name: xG0
    description: "ghost 0's column (0 = removed from the game)"
  - name: yG0
    description: "ghost 0's row (0 = removed from the game)"
  - name: dG0
    description: "ghost 0's heading (same codes as dP)"
  - name: xG1
    description: "ghost 1's column (0 = removed from the game)"
  - name: yG1
    description: "ghost 1's row (0 = removed from the game)"
  - name: dG1
    description: "ghost 1's heading (same codes as dP)"
  - name: steps
    description: "Pac-Man moves made so far (the game ends at {{ max_steps }})"

requirements:
  - name: crash
    formula: 'F "Crash"'
    bound: "<="
    threshold: {{ crash_threshold }}
    description: "Pac-Man shares a cell with a ghost at some point during the {{ max_steps }} moves."
