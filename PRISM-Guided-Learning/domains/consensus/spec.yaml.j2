# The policy is the scheduler: each action lets one process take its next step.
actions:
{% for i in procs %}
  p{{ i }}: "process {{ i }} takes its next step (flip, write or check); if process {{ i }} has finished, the next unfinished process after it does"
{% endfor %}

# Policy-visible variables: every state variable, as 1-2-3-Go! uses.
variables:
  - name: counter
    description: "the shared counter: each write moves it one step (tails down, heads up); a check at or below the tails barrier decides tails, at or above the heads barrier heads"
{% for i in procs %}
  - name: pc{{ i }}
    description: "process {{ i }}: 0 about to flip its coin, 1 about to write it (move the counter), 2 about to check the counter, 3 finished"
  - name: coin{{ i }}
    description: "process {{ i }}: the coin it flipped (0 tails, 1 heads) while about to write; once finished, its decision"
{% endfor %}

{% include "_vocabulary.yaml.j2" %}

requirements:
  - name: disagree
    formula: 'F "finished" & !"agree"'
    bound: ">="
    threshold: {{ disagree_threshold }}
    description: "All processes finish and they do not all decide the same value."
