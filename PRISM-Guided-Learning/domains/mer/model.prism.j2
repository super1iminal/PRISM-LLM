  dd : bool init false;

  [arb_reclaim] ((r != 0) & (driveUser = 0)) & en_arb_reclaim -> (gc'=true) & (r'=0);
  [u1_cancel_comm] (commUser = 1) & en_u1_cancel_comm -> (commUser'=0);
  [u1_cancel_drive] (driveUser = 1) & en_u1_cancel_drive -> (driveUser'=0);
  [u1_deny_comm] ((s = 1) & dc) & en_u1_deny_comm -> (dc'=false) & (s'=0);
  [u1_deny_drive] ((s = 1) & dd) & en_u1_deny_drive -> (dd'=false) & (s'=0);
  [u1_grant_comm] ((s = -1) & gc) & en_u1_grant_comm -> (gc'=false) & (s'=0) & (commUser'=1);
  [u1_grant_comm] (((!(gd) & (commUser = 0)) & (driveUser = 0)) & (gc & (s = 1))) & en_u1_grant_comm -> (gc'=false) & (s'=0) & (commUser'=1);
  [u1_grant_drive] (((s = 1) & (driveUser = 0)) & gd) & en_u1_grant_drive -> (gd'=false) & (s'=0) & (driveUser'=1);
  [u1_request_comm] (((k = n) & (commUser = 0)) & ((driveUser != 0) & (s = 0))) & en_u1_request_comm -> (s'=1) & (r'=driveUser);
  [u1_request_comm] (((s = 0) & (commUser = 0)) & (driveUser = 0)) & en_u1_request_comm -> (gc'=true) & (s'=1);
  [u1_request_comm] ((s = 0) & (commUser != 0)) & en_u1_request_comm -> (dc'=true) & (s'=1);
  [u1_request_comm] (((k < n) & (commUser = 0)) & ((driveUser != 0) & (s = 0))) & en_u1_request_comm -> 0.8 : (s'=1) & (r'=driveUser) & (k'=(k + 1)) + 0.2 : (gc'=true) & (s'=-1) & (k'=(k + 1));
  [u1_request_drive] (((s = 0) & (commUser = 0)) & (driveUser = 0)) & en_u1_request_drive -> (gd'=true) & (s'=1);
  [u1_request_drive] ((s = 0) & ((commUser != 0) | (driveUser != 0))) & en_u1_request_drive -> (dd'=true) & (s'=1);
  [u1_rescind_drive] ((r = 1) & (driveUser = 1)) & en_u1_rescind_drive -> (gc'=true) & (r'=0);
  [u2_cancel_comm] (commUser = 2) & en_u2_cancel_comm -> (commUser'=0);
  [u2_cancel_drive] (driveUser = 2) & en_u2_cancel_drive -> (driveUser'=0);
  [u2_deny_comm] ((s = 2) & dc) & en_u2_deny_comm -> (dc'=false) & (s'=0);
  [u2_deny_drive] ((s = 2) & dd) & en_u2_deny_drive -> (dd'=false) & (s'=0);
  [u2_grant_comm] (((!(gd) & (commUser = 0)) & (driveUser = 0)) & (gc & (s = 2))) & en_u2_grant_comm -> (gc'=false) & (s'=0) & (commUser'=2);
  [u2_grant_drive] (((s = 2) & (driveUser = 0)) & gd) & en_u2_grant_drive -> (gd'=false) & (s'=0) & (driveUser'=2);
  [u2_request_comm] (((s = 0) & (commUser = 0)) & (driveUser = 0)) & en_u2_request_comm -> (gc'=true) & (s'=2);
  [u2_request_comm] ((s = 0) & (commUser != 0)) & en_u2_request_comm -> (dc'=true) & (s'=2);
  [u2_request_comm] (((s = 0) & (commUser = 0)) & (driveUser != 0)) & en_u2_request_comm -> (s'=2) & (r'=driveUser);
  [u2_request_drive] (((s = 0) & (commUser = 0)) & (driveUser = 0)) & en_u2_request_drive -> (gd'=true) & (s'=2);
  [u2_request_drive] ((s = 0) & ((commUser != 0) | (driveUser != 0))) & en_u2_request_drive -> (dd'=true) & (s'=2);
  [u2_rescind_drive] ((r = 2) & (driveUser = 2)) & en_u2_rescind_drive -> (gc'=true) & (r'=0);

