actions:
  keep: "keep the current altitude (becomes the highest allowed altitude if the visibility no longer allows it)"
  low: "search at low altitude next (always possible; slowest search, most thruster failures)"
  med: "search at medium altitude next (becomes low if the visibility is poor)"
  high: "search at high altitude next (becomes the highest altitude the visibility allows; fastest search, fewest thruster failures)"

# Policy-visible variables. The task feature (follow) and the inspection counters (d_insp,
# t_failed) stay hidden; the state s already says whether the AUV is searching, and while
# searching t_failed is always 0. The water visibility is hidden too: the managed subsystem
# enforces its limits (requests are clamped), so the policy only requests an altitude.
variables:
  - name: s
    description: "mission state: {% for st, code in states.items() %}{{ code }} = {{ st }}{% if not loop.last %}, {% endif %}{% endfor %}"
  - name: alt
    description: "currently active altitude: 0 = low, 1 = med, 2 = high"

requirements:
  - name: no_thruster_failure
    formula: 'G !"thruster_failure"'
    bound: ">="
    threshold: {{ safe_threshold }}
    description: "No thruster ever fails during the whole mission (the AUV only passes through safe states)."
  - name: done_in_time
    formula: 'F<={{ deadline }} "done"'
    bound: ">="
    threshold: {{ on_time_threshold }}
    description: "The inspection of {{ inspect }} m of pipeline is finished within {{ deadline }} steps (minutes)."
