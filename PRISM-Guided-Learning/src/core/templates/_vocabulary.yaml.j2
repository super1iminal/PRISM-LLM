{% if rule_constants is defined %}
# Extended rule vocabulary, used only with the run setting rules.extended. From the domain context:
# rule_constants [{name, value, description}], rule_features [{name, description, expr | per_action}].
constants:
{% for c in rule_constants %}
  - {name: {{ c.name }}, value: {{ c.value }}, description: {{ c.description | tojson }}}
{% endfor %}
features:
{% for f in rule_features %}
  - name: {{ f.name }}
    description: {{ f.description | tojson }}
{% if f.per_action is defined %}
    per_action:
{% for a, e in f.per_action.items() %}
      {{ a }}: {{ e | tojson }}
{% endfor %}
{% else %}
    expr: {{ f.expr | tojson }}
{% endif %}
{% endfor %}
{% endif %}
